# Copie este arquivo para .env.local e preencha. O .env.local NUNCA vai para o git (veja o .gitignore).
# Variáveis do ambiente do sistema têm prioridade sobre as deste arquivo.

# Modo do app: "real" (chama o sandbox de Crédito da Celcoin) ou "simulado" (dados do protótipo, sem chamadas externas).
# Se ficar vazio: sem .env.local → simulado; com .env.local → real (e o servidor NÃO inicia se algo faltar abaixo).
CREDIT_MODE=simulado

# --- Obrigatórias no modo real -------------------------------------------------------------------------------
# Credenciais OAuth (client_credentials) do SANDBOX de Crédito.
CREDIT_CLIENT_ID=
CREDIT_CLIENT_SECRET=

# URLs do sandbox. Precisam ser https e ter o label "sandbox" no hostname; qualquer outra é recusada.
# CREDIT_AUTH_URL pode ser a URL completa do endpoint de token.
CREDIT_API_URL=
CREDIT_AUTH_URL=

# UUID do produto "Crédito Pessoal (CCB)" instalado no seu sandbox.
CREDIT_PRODUCT_ID=

# UUID do funding (conta de onde sai o dinheiro) do seu sandbox.
CREDIT_FUNDING_ID=

# Taxa de juros mensal em fração (ex.: 0.0299 equivale a 2,99% ao mês). Entre 0 e 1.
CREDIT_INTEREST_MONTHLY=

# --- Opcionais -----------------------------------------------------------------------------------------------
# Usar outro arquivo de configuração no lugar de .env.local (usado pelos testes).
# CREDIT_ENV_FILE=

# Porta do servidor (padrão 3000). O servidor só escuta em 127.0.0.1.
# PORT=3000
